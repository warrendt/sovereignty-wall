# Copy to .env (git-ignored) or set these in your host's environment settings.

# Enables the admin/moderation surface. Empty or unset disables it (fail closed).
# Generate one with: openssl rand -base64 24
ADMIN_KEY=

# HTTP port to listen on.
PORT=3000

# Where answers.json is written. Must be persistent storage when deployed.
DATA_DIR=./data

# Maximum stored answers; the oldest are evicted first once the cap is reached.
MAX_ENTRIES=2000

# Per-IP submission rate limit.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Concurrent SSE connection cap and heartbeat interval.
MAX_STREAM_CLIENTS=500
SSE_HEARTBEAT_MS=15000
